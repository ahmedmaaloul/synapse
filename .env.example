# ─────────────────────────────────────────────────────────
# Synapse — environment configuration
# Copyright (c) 2026 Ahmed Maaloul · AGPL-3.0-or-later
# https://github.com/ahmedmaaloul/synapse
#
# Copy to `.env` and edit:   cp .env.example .env
#
# EVERY value below has a safe default in backend/app/config.py, so the app
# boots with a completely empty .env. You only need credentials for the ONE
# provider you actually select. A provider that needs a key fails with a clear,
# actionable message when it is invoked — never at startup.
#
# Zero-key path: keep EMBEDDING_PROVIDER=fastembed and seed the demo graph
# (`make demo`). Nothing here is required for that.
# ─────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════
# 1. DATABASE — Neo4j
# ═════════════════════════════════════════════════════════
# bolt://neo4j:7687      → API running inside docker compose (default)
# bolt://localhost:7687  → API running on the host (make backend-dev, Codespaces)
# neo4j+s://xxx.databases.neo4j.io → Neo4j Aura (see DEPLOYMENT.md)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=synapse_secret


# ═════════════════════════════════════════════════════════
# 2. CHAT / EXTRACTION PROVIDER
# ═════════════════════════════════════════════════════════
# Exactly one of:
#   gemini | claude | openai | azure_openai | vertex | bedrock
#   groq | mistral | ollama | openai_compatible
#
# Shipped in backend/requirements.txt (no extra install):
#   gemini · claude · openai · azure_openai · ollama · openai_compatible
# Opt-in — `pip install -r backend/requirements-providers.txt` (or `make providers`):
#   vertex · bedrock · groq · mistral
LLM_PROVIDER=gemini


# ── Google Gemini ─────────────────────────────────────────
# Free tier · key: https://aistudio.google.com/apikey
# Required when LLM_PROVIDER=gemini (or EMBEDDING_PROVIDER=gemini).
GOOGLE_API_KEY=
# Optional. "gemini-flash-latest" tracks the current free-tier flash model.
# Tip: pinned ids (e.g. gemini-2.0-flash) can report "quota limit: 0" on a new
# key — use the -latest alias if that happens.
GEMINI_CHAT_MODEL=gemini-flash-latest


# ── Anthropic Claude ──────────────────────────────────────
# Key: https://console.anthropic.com/
# Required when LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=
# Optional.
ANTHROPIC_MODEL=claude-sonnet-5


# ── OpenAI ────────────────────────────────────────────────
# Key: https://platform.openai.com/api-keys
# Required when LLM_PROVIDER=openai (or EMBEDDING_PROVIDER=openai).
OPENAI_API_KEY=
# Optional.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional. Only used when EMBEDDING_PROVIDER=openai — 1536 dims,
# so set EMBEDDING_DIM=1536 to match.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ── Azure OpenAI ──────────────────────────────────────────
# Portal → your resource → "Keys and Endpoint".
# NOTE: Azure addresses *deployments*, not model names. Use the deployment name
# you created in Azure AI Foundry.
# Required when LLM_PROVIDER=azure_openai: API_KEY + ENDPOINT + CHAT_DEPLOYMENT.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=              # https://<resource>.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Required only when EMBEDDING_PROVIDER=azure_openai.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Optional.
AZURE_OPENAI_API_VERSION=2024-10-21


# ── Google Vertex AI (GCP) ────────────────────────────────
# Needs `pip install -r backend/requirements-providers.txt`.
# No API key: authenticate with Application Default Credentials —
#   gcloud auth application-default login
# or point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON key.
# Required when LLM_PROVIDER=vertex (or EMBEDDING_PROVIDER=vertex).
VERTEX_PROJECT=                     # your GCP project id
# Optional.
VERTEX_LOCATION=us-central1
VERTEX_CHAT_MODEL=gemini-2.0-flash
# Optional. Only for EMBEDDING_PROVIDER=vertex — 768 dims → EMBEDDING_DIM=768.
VERTEX_EMBEDDING_MODEL=text-embedding-005
# Optional, standard Google SDK variable (alternative to `gcloud auth`).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json


# ── AWS Bedrock ───────────────────────────────────────────
# Needs `pip install -r backend/requirements-providers.txt`.
# No API key: credentials come from the standard AWS chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE, or an instance role).
# Request model access first: https://console.aws.amazon.com/bedrock/home#/modelaccess
# Required when LLM_PROVIDER=bedrock (or EMBEDDING_PROVIDER=bedrock).
BEDROCK_REGION=us-east-1
# Optional. Chat goes through the unified Converse API.
BEDROCK_CHAT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# Optional. Only for EMBEDDING_PROVIDER=bedrock — 1024 dims → EMBEDDING_DIM=1024.
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# Optional AWS credential passthrough (or use ~/.aws / an instance role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=


# ── Groq (very fast open-weights inference) ───────────────
# Needs `pip install -r backend/requirements-providers.txt`.
# Free tier · key: https://console.groq.com/keys
# Required when LLM_PROVIDER=groq.
GROQ_API_KEY=
# Optional.
GROQ_CHAT_MODEL=llama-3.3-70b-versatile


# ── Mistral AI ────────────────────────────────────────────
# Needs `pip install -r backend/requirements-providers.txt`.
# Key: https://console.mistral.ai/api-keys/
# Required when LLM_PROVIDER=mistral.
MISTRAL_API_KEY=
# Optional.
MISTRAL_CHAT_MODEL=mistral-large-latest


# ── Ollama (fully local, fully private, no key) ───────────
# Requires the Ollama app running on the host, and the model pulled:
#   ollama pull mistral
# Optional — these defaults work for Docker on macOS/Windows.
# From inside a container use host.docker.internal; on Linux use
# http://172.17.0.1:11434, and http://localhost:11434 when running on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=mistral
# Optional. Only for EMBEDDING_PROVIDER=ollama — nomic-embed-text is 768 dims
# → set EMBEDDING_DIM=768 and run `ollama pull nomic-embed-text`.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# ── Any OpenAI-compatible /v1 endpoint ────────────────────
# This single provider unlocks OpenRouter, Together, DeepSeek, Fireworks,
# vLLM, LM Studio and llama.cpp's server — with zero extra dependencies.
# Required when LLM_PROVIDER=openai_compatible: BASE_URL (+ CHAT_MODEL).
#
#   OpenRouter  https://openrouter.ai/api/v1
#   Together    https://api.together.xyz/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Fireworks   https://api.fireworks.ai/inference/v1
#   vLLM        http://localhost:8000/v1
#   LM Studio   http://localhost:1234/v1
#   llama.cpp   http://localhost:8080/v1
OPENAI_COMPATIBLE_BASE_URL=
# Optional for local servers (they ignore it); required for hosted gateways.
OPENAI_COMPATIBLE_API_KEY=
# The model id *as that gateway names it*, e.g. deepseek/deepseek-chat.
OPENAI_COMPATIBLE_CHAT_MODEL=gpt-oss-120b


# ═════════════════════════════════════════════════════════
# 3. EMBEDDINGS (vector GraphRAG retrieval)
# ═════════════════════════════════════════════════════════
# One of: fastembed | gemini | ollama | openai | azure_openai
#         vertex | bedrock | cohere | fake
#
# fastembed = local, no API key, no GPU (the default — great for demos).
# fake      = deterministic hash embedder for offline dev and tests.
# The cloud options reuse the credentials of the matching chat provider above.
EMBEDDING_PROVIDER=fastembed

# ⚠️ EMBEDDING_DIM MUST match the active embedding model, because it sizes the
# Neo4j vector index. Changing embedding provider requires re-ingesting (or
# re-seeding) so every vector lives in the same space.
#   fastembed  BAAI/bge-small-en-v1.5      →  384   (default)
#   gemini     models/text-embedding-004   →  768
#   ollama     nomic-embed-text            →  768
#   vertex     text-embedding-005          →  768
#   openai     text-embedding-3-small      →  1536
#   bedrock    amazon.titan-embed-text-v2  →  1024
#   cohere     embed-english-v3.0          →  1024
#   azure      whatever your deployment's model uses
EMBEDDING_DIM=384

# Optional model overrides (only the one matching EMBEDDING_PROVIDER is read).
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── Cohere (embeddings only) ──────────────────────────────
# Needs `pip install -r backend/requirements-providers.txt`.
# Key: https://dashboard.cohere.com/api-keys
# Required when EMBEDDING_PROVIDER=cohere.
COHERE_API_KEY=
# Optional — embed-english-v3.0 is 1024 dims → EMBEDDING_DIM=1024.
COHERE_EMBEDDING_MODEL=embed-english-v3.0


# ═════════════════════════════════════════════════════════
# 4. APP
# ═════════════════════════════════════════════════════════
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
# Max PDF chunks processed per document (guards runaway ingest cost/time).
MAX_CHUNKS=40

# Optional generation / ingest tuning.
# EXTRACTION_TEMPERATURE=0.1
# CHAT_TEMPERATURE=0.3
# EXTRACTION_CONCURRENCY=5      # concurrent LLM extraction calls
# EXTRACTION_TIMEOUT=180        # per-chunk extraction timeout, seconds
# APP_NAME=Synapse
# DEBUG=true


# ═════════════════════════════════════════════════════════
# 4b. GRAPHRAG BRAIN (all optional — sensible defaults shown)
# ═════════════════════════════════════════════════════════

# ── Entity resolution ─────────────────────────────────────
# Merges near-duplicate entities ("Ahmed" / "Ahmed Maaloul",
# "Postgres" / "PostgreSQL") into one canonical node. A pair merges only when
# BOTH signals agree — embedding cosine AND fuzzy name similarity — and never
# across different entity types. Raise the thresholds if you see wrong merges.
# ENTITY_RESOLUTION_ENABLED=true
# ENTITY_RESOLUTION_THRESHOLD=0.93        # embedding cosine floor
# ENTITY_RESOLUTION_NAME_THRESHOLD=0.87   # normalized name-similarity floor

# ── Communities (corpus-level "themes") ───────────────────
# Louvain clustering (networkx, seed=42 so partitions are reproducible) groups
# the graph into topics, each summarized by the LLM. This is what lets Synapse
# answer whole-corpus questions ("what are the main themes?") that top-k vector
# retrieval structurally cannot.
# COMMUNITY_DETECTION_ENABLED=true
# COMMUNITY_RESOLUTION=1.0                # higher => more, smaller communities
# COMMUNITY_MIN_SIZE=3                    # smaller clusters are treated as noise
# COMMUNITY_MAX_MEMBERS_IN_SUMMARY=30     # caps summary prompt cost
# COMMUNITY_SUMMARY_TEMPERATURE=0.2

# ── Retrieval ─────────────────────────────────────────────
# RETRIEVAL_MAX_HOPS=2                    # 2 enables multi-hop reasoning paths
# QUERY_ROUTING_ENABLED=true              # route thematic questions to communities
# MAX_REASONING_PATHS=6                   # paths shown alongside an answer

# ── Source chunks (text units) ────────────────────────────
# Extraction distills prose into short entity descriptions, which is lossy.
# Keeping the source chunks and returning them ALONGSIDE the graph gives the
# model both the structure and the original evidence — and powers the
# "sources" provenance shown under each answer.
# STORE_SOURCE_CHUNKS=true                # persist (:Chunk) nodes at ingest
# CHUNK_RETRIEVAL_ENABLED=true            # include source excerpts in answers
# CHUNK_TOP_K=4                           # excerpts per answer
# CHUNK_CONTEXT_MAX_CHARS=4000            # hard cap on excerpt characters


# ═════════════════════════════════════════════════════════
# 5. HOST PORTS (override if 8000/3000 clash with another project)
# ═════════════════════════════════════════════════════════
# BACKEND_PORT=8001
# FRONTEND_PORT=3001
# If you change BACKEND_PORT you MUST also point the frontend at it — the value
# is baked in at build time — then rebuild: docker compose up -d --build
# NEXT_PUBLIC_API_URL=http://localhost:8001
