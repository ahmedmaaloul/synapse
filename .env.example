# ─────────────────────────────────────────────────────────
# Project Synapse — environment configuration
# Copy to `.env` and fill in. Every value has a safe default;
# you only need a key for the cloud provider you choose.
# ─────────────────────────────────────────────────────────

# ── Neo4j ────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687          # bolt://localhost:7687 when running the API outside Docker
NEO4J_USER=neo4j
NEO4J_PASSWORD=synapse_secret

# ── LLM provider ─────────────────────────────────────────
# One of: gemini | claude | ollama
LLM_PROVIDER=gemini

# Google Gemini (free tier): https://aistudio.google.com/apikey
# Tip: if you hit "quota limit: 0" for a pinned model, use gemini-flash-latest.
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest

# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ollama (fully local — no key needed; requires the Ollama app running)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=mistral

# ── Embeddings (vector retrieval) ────────────────────────
# One of: fastembed (local, no key) | gemini | ollama | fake (tests)
# IMPORTANT: EMBEDDING_DIM must match the model:
#   fastembed bge-small-en-v1.5 = 384 · gemini text-embedding-004 = 768 · nomic-embed-text = 768
EMBEDDING_PROVIDER=fastembed
EMBEDDING_DIM=384

# ── App ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
MAX_CHUNKS=40

# ── Host ports (override if 8000/3000 clash with another project) ──
# BACKEND_PORT=8001
# FRONTEND_PORT=3001
# If you change BACKEND_PORT you MUST also point the frontend at it
# (baked in at build time), then rebuild: docker compose up -d --build
# NEXT_PUBLIC_API_URL=http://localhost:8001
