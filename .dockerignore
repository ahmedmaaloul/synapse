# Both images build from the REPO ROOT so they can COPY LICENSE and NOTICE
# (see backend/Dockerfile and frontend/Dockerfile). That makes the whole repo
# the build context, so everything the images don't need must be excluded here
# or every `docker build` uploads hundreds of MB (node_modules alone is ~500MB).

# VCS
.git
.github
.gitignore

# Secrets — never bake real credentials into a layer.
.env
.env.*
!.env.example

# Node / Next.js — reinstalled from package-lock.json, rebuilt in the image.
node_modules
**/node_modules
.next
**/.next
out
**/out
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python build/caches
__pycache__
**/__pycache__
*.py[cod]
*.egg-info
**/*.egg-info
.venv
venv
env
**/.venv
.pytest_cache
**/.pytest_cache
.mypy_cache
**/.mypy_cache
.ruff_cache
**/.ruff_cache
dist
build
# Bare `dist`/`build` only match at the context root; the MCP image COPYs
# packages/synapse-graphrag/ wholesale, so its local build outputs need the
# nested form (egg-info is already covered by **/*.egg-info above).
packages/**/dist
packages/**/build

# Local-only files (.gitignore keeps them out of git; keep them out of every
# image too): the private research harness and its runs, the user's Synapse Lab
# runs and uploaded QA files (the API would serve them from a baked-in copy),
# and benchmark reports that describe one run.
backend/research
backend/lab_runs
backend/benchmarks/public/results_hotpotqa.md
backend/benchmarks/procedural/results_procedural.md
paper

# Docs & screenshots — pure weight, nothing imports them.
docs/*.png
docs/*.jpg
docs/*.gif

# Local scratch / editor / OS noise
.scratch
scratch
tmp
.DS_Store
.vscode
.idea
.devcontainer

# Compose/deploy manifests aren't needed inside an image.
docker-compose.yml
docker-compose.*.yml
