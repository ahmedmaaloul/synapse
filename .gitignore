# Environments — never commit real credentials.
# Covers .env, .env.local, .env.bak.<ts>, .env.production, etc.
# .env.example is the ONLY one that must stay tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/
.vercel
next-env.d.ts

# OS
.DS_Store

# IDE
.vscode/
.idea/

